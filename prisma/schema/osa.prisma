model OSAChecklist {
  yearMonth    Int    @map("year_month")
  storeCode    String @map("store_code")
  productCode  String @map("product_code")
  oldProductId String @map("old_product_id")
  newProductId String @map("new_product_id")
  stock        Int    @map("stock")

  @@id([yearMonth, storeCode, productCode])
  @@map("osa_checklist")
}

model OSA {
  yearMonth   Int    @map("year_month")
  storeCode   String @map("store_code")
  productCode String @map("product_code")
  auditDate   Int    @map("audit_date")

  stock        Int
  currentStock Int     @map("current_stock")
  priceList    Boolean @map("price_list")
  location     String

  note                String?
  comment             String?
  projectTeamRevised  String? @map("project_team_revised")
  projectTeamResponse String? @map("project_team_response")
  finalReject         Boolean @default(false) @map("final_reject")
  saleRepFeedBack     String? @map("sale_rep_feedback")

  qcNote         String? @map("qc_note")
  qcIsReject     Boolean @default(false) @map("qc_is_reject")
  qcReasonReject String? @map("qc_reason_reject")
  qcEvidence     String? @map("qc_evidence")

  allowEditPrice Boolean @default(false) @map("allow_edit")
  priceAfterEdit Int?    @map("price_after_edit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  store   Store   @relation(fields: [storeCode], references: [essStoreCode])
  product Product @relation(fields: [productCode], references: [productCode])

  auditById String? @map("audit_by_id")
  auditBy   User?   @relation("audit_by_id", fields: [auditById], references: [id])
  qcById    String? @map("qc_by_id")
  qcBy      User?   @relation("qc_by_id", fields: [qcById], references: [id])

  @@id([yearMonth, storeCode, productCode, auditDate])
  @@index([yearMonth, storeCode])
  @@index([storeCode])
  @@index([productCode])
  @@map("osa")
}
