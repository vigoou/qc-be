model OffLocation {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("off_location")
}
model OSAChecklist {
  yearMonth    Int    @map("year_month")
  storeCode    String @map("store_code")
  productCode  String @map("product_code")
  oldProductId String @map("old_product_id")
  newProductId String @map("new_product_id")
  stock        Int    @map("stock")

  @@id([yearMonth, storeCode, productCode])
  @@map("osa_checklist")
}

model OSA {
  yearMonth   Int    @map("year_month")
  storeCode   String @map("store_code")
  productCode String @map("product_code")
  auditDate   Int    @map("audit_date")

  stock        Int
  currentStock Int     @map("current_stock")
  priceList    Boolean @map("price_list")
  location     String

  note                String?
  comment             String?
  projectTeamRevised  String? @map("project_team_revised")
  projectTeamResponse String? @map("project_team_response")
  finalReject         Boolean @default(false) @map("final_reject")
  saleRepFeedBack     String? @map("sale_rep_feedback")

  qcNote         String? @map("qc_note")
  qcIsReject     Boolean @default(false) @map("qc_is_reject")
  qcReasonReject String? @map("qc_reason_reject")
  qcEvidence     String? @map("qc_evidence")

  allowEditPrice Boolean @default(false) @map("allow_edit")
  priceAfterEdit Int?    @map("price_after_edit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  store   Store   @relation(fields: [storeCode], references: [essStoreCode])
  product Product @relation(fields: [productCode], references: [productCode])

  auditById String? @map("audit_by_id")
  auditBy   User?   @relation("audit_by_id", fields: [auditById], references: [id])
  qcById    String? @map("qc_by_id")
  qcBy      User?   @relation("qc_by_id", fields: [qcById], references: [id])

  @@id([yearMonth, storeCode, productCode, auditDate])
  @@index([yearMonth, storeCode])
  @@index([storeCode])
  @@index([productCode])
  @@map("osa")
}
model PromotionChecklist {
  yearMonth   Int    @map("year_month")
  storeCode   String @map("store_code")
  promotionId String @map("promotion_id")

  @@id([yearMonth, storeCode, promotionId])
  @@index([yearMonth, storeCode, promotionId], name: "idx_year_month_store_code_promotion_id")
  @@map("promotion_checklist")
}

model Promotion {
  id        String @id @default(cuid())
  yearMonth Int    @map("year_month")

  stock        Int
  currentStock Int     @map("current_stock")
  priceList    Boolean @map("price_list")
  location     String

  note               String?
  comment            String
  projectTeamRevised String? @map("project_team_revised")
  projectTeamReponse String? @map("project_team_response")
  finalReject        Boolean @default(false) @map("final_reject")
  saleRepFeedBack    String? @map("sale_rep_feedback")
  auditStatus        String  @map("audit_status")

  qcNote         String? @map("qc_note")
  qcIsReject     Boolean @default(false) @map("qc_is_reject")
  qcReasonReject String? @map("qc_reason_reject")

  allowEditPrice Boolean @default(false) @map("allow_edit")
  priceAfterEdit Int?    @map("price_after_edit")

  createdAt DateTime @default(now()) @map("created_at") // time audit
  updatedAt DateTime @default(now()) @map("updated_at")

  storeCode   String  @map("store_code")
  store       Store   @relation(fields: [storeCode], references: [essStoreCode])
  productCode String  @map("product_code")
  product     Product @relation(fields: [productCode], references: [productCode])

  auditById String? @map("audit_by_id")
  auditBy   User?   @relation("audit_by_id", fields: [auditById], references: [id])
  qcById    String? @map("qc_by_id")
  qcBy      User?   @relation("qc_by_id", fields: [qcById], references: [id])

  @@index([yearMonth], name: "idx_year_month_promotion")
  @@map("promotion")
}
model RentalChecklist {
  yearMonth Int    @map("year_month")
  storeCode String @map("store_code")
  rentalId  String @map("rental_id")

  @@id([yearMonth, storeCode, rentalId])
  @@index([yearMonth, storeCode, rentalId], name: "idx_year_month_store_code_rental_id")
  @@map("rental_checklist")
}

model Rental {
  id        String @id @default(cuid())
  yearMonth Int    @map("year_month")

  stock        Int
  currentStock Int     @map("current_stock")
  priceList    Boolean @map("price_list")
  location     String

  note               String?
  comment            String
  projectTeamRevised String? @map("project_team_revised")
  projectTeamReponse String? @map("project_team_response")
  finalReject        Boolean @default(false) @map("final_reject")
  saleRepFeedBack    String? @map("sale_rep_feedback")
  auditStatus        String  @map("audit_status")

  qcNote         String? @map("qc_note")
  qcIsReject     Boolean @default(false) @map("qc_is_reject")
  qcReasonReject String? @map("qc_reason_reject")

  allowEditPrice Boolean @default(false) @map("allow_edit")
  priceAfterEdit Int?    @map("price_after_edit")

  createdAt DateTime @default(now()) @map("created_at") // time audit
  updatedAt DateTime @default(now()) @map("updated_at")

  storeCode   String  @map("store_code")
  store       Store   @relation(fields: [storeCode], references: [essStoreCode])
  productCode String  @map("product_code")
  product     Product @relation(fields: [productCode], references: [productCode])

  auditById String? @map("audit_by_id")
  auditBy   User?   @relation("audit_by_id", fields: [auditById], references: [id])
  qcById    String? @map("qc_by_id")
  qcBy      User?   @relation("qc_by_id", fields: [qcById], references: [id])

  @@index([yearMonth], name: "idx_year_month_rental")
  @@map("rental")
}
model SOSChecklist {
  yearMonth Int    @map("year_month")
  storeCode String @map("store_code")
  category  String @map("category")

  @@id([yearMonth, storeCode, category])
  @@index([yearMonth, storeCode, category], name: "idx_year_month_store_code_category_sos")
  @@map("sos_checklist")
}

model SOS {
  yearMonth       Int    @map("year_month")
  storeCode       String @map("store_code")
  categoryCode    String @map("category_code")
  subCategoryCode String @map("sub_category_code")
  brandCode       String @map("brand_code")
  auditDate       Int    @map("audit_date")

  typeOL          String? @map("type_ol") // only for Small format store
  totalLength     Float?  @default(0) @map("total_length")
  sosLength       Float?  @default(0) @map("sos_length")
  msUnileverLength Float?  @default(0) @map("ms_unilever_length")

  olUnileverLength  Float? @default(0) @map("ol_unilever_length") // small 
  sosUnileverLength Float? @default(0) @map("sos_unilever_length") // small

  privateLabelLength  Float? @default(0) @map("private_label_length") //big - MS Chiều dài nhãn riêng DOB 
  importedLabelLength Float? @default(0) @map("imported_label_length") //big - MS Chiều dài hàng nhập khẩu

  note    String?
  comment String?

  projectTeamRevised  String? @map("project_team_revised")
  projectTeamResponse String? @map("project_team_response")
  finalReject         Boolean @default(false) @map("final_reject")
  saleRepFeedBack     String? @map("sale_rep_feedback")

  qcNote         String? @map("qc_note")
  qcIsReject     Boolean @default(false) @map("qc_is_reject")
  qcReasonReject String? @map("qc_reason_reject")
  qcEvidence     String? @map("qc_evidence")

  createdAt DateTime @default(now()) @map("created_at") // time audit
  updatedAt DateTime @default(now()) @map("updated_at")

  brand       Brand       @relation(fields: [brandCode], references: [code])
  category    Category    @relation(fields: [categoryCode], references: [code])
  subCategory SubCategory @relation(fields: [subCategoryCode], references: [code])
  store       Store       @relation(fields: [storeCode], references: [essStoreCode])

  auditById String? @map("audit_by_id")
  auditBy   User?   @relation("audit_by_id", fields: [auditById], references: [id])
  qcById    String? @map("qc_by_id")
  qcBy      User?   @relation("qc_by_id", fields: [qcById], references: [id])

  @@id([yearMonth, storeCode, categoryCode, subCategoryCode, brandCode, auditDate])
  @@index([yearMonth, storeCode])
  @@index([storeCode])
  @@map("sos")
}
model User {
  id             String      @id @default(cuid())
  userName       String      @unique @map("user_name")
  email          String      @unique
  phoneNumber    String?     @map("phone_number")
  name           String?
  password       String
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @map("updated_at")
  roleId         String      @map("role_id")
  role           Role        @relation(fields: [roleId], references: [id])
  supervisorId   Store[]     @relation("supervisor_id")
  saleRepId      Store[]     @relation("sale_rep_id")
  sipId          Store[]     @relation("sip_id")
  auditorsId     Store[]     @relation("auditors_id")
  osasAudit      OSA[]       @relation("audit_by_id")
  osasQC         OSA[]       @relation("qc_by_id")
  sosAudit       SOS[]       @relation("audit_by_id")
  sosQC          SOS[]       @relation("qc_by_id")
  npdAudit       NPD[]       @relation("audit_by_id")
  npdQC          NPD[]       @relation("qc_by_id")
  rentalAudit    Rental[]    @relation("audit_by_id")
  rentalQC       Rental[]    @relation("qc_by_id")
  promotionAudit Promotion[] @relation("audit_by_id")
  promotionQC    Promotion[] @relation("qc_by_id")

  @@map("users")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  User      User[]

  @@map("role")
}
